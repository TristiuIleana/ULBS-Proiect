datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  SPECIALIST
  CLIENT
}

enum ServiceCategory {
  BROWS
  MAKEUP
}

enum AppointmentStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum WaitlistStatus {
  WAITING
  NOTIFIED
  CLAIMED
  EXPIRED
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  phone         String
  firstName     String    @map("first_name")
  lastName      String    @map("last_name")
  role          Role      @default(CLIENT)
  passwordHash  String?   @map("password_hash")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  schedules              SpecialistSchedule[]
  overrides              ScheduleOverride[]
  clientAppointments     Appointment[]        @relation("ClientAppointments")
  specialistAppointments Appointment[]        @relation("SpecialistAppointments")
  waitlistEntries        WaitlistEntry[]

  @@map("users")
}

model Service {
  id                   String          @id @default(uuid()) @db.Uuid
  name                 String
  category             ServiceCategory
  description          String?
  priceRon             Decimal         @map("price_ron") @db.Decimal(10, 2)
  totalDurationMinutes Int             @map("total_duration_minutes")
  isSplit              Boolean         @default(false) @map("is_split")
  isActive             Boolean         @default(true) @map("is_active")
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.Timestamptz()

  stages          ServiceStage[]
  appointments    Appointment[]
  waitlistEntries WaitlistEntry[]

  @@map("services")
}

model ServiceStage {
  id              String   @id @default(uuid()) @db.Uuid
  serviceId       String   @map("service_id") @db.Uuid
  stageOrder      Int      @map("stage_order")
  name            String
  durationMinutes Int      @map("duration_minutes")
  isBusy          Boolean  @default(true) @map("is_busy")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, stageOrder])
  @@map("service_stages")
}

model SpecialistSchedule {
  id           String   @id @default(uuid()) @db.Uuid
  specialistId String   @map("specialist_id") @db.Uuid
  dayOfWeek    Int      @map("day_of_week") // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  startTime    String   @map("start_time") // e.g. "09:00" in Europe/Bucharest
  endTime      String   @map("end_time") // e.g. "19:00" in Europe/Bucharest
  isWorking    Boolean  @default(true) @map("is_working")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  specialist User @relation(fields: [specialistId], references: [id], onDelete: Cascade)

  @@unique([specialistId, dayOfWeek])
  @@map("specialist_schedules")
}

model ScheduleOverride {
  id              String   @id @default(uuid()) @db.Uuid
  specialistId    String   @map("specialist_id") @db.Uuid
  date            String   // "YYYY-MM-DD" in Europe/Bucharest
  isWorking       Boolean  @default(false) @map("is_working")
  startTime       String?  @map("start_time")
  endTime         String?  @map("end_time")
  reason          String?
  isFullDayPolicy Boolean  @default(false) @map("is_full_day_policy")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  specialist User @relation(fields: [specialistId], references: [id], onDelete: Cascade)

  @@unique([specialistId, date])
  @@map("schedule_overrides")
}

model Appointment {
  id                 String            @id @default(uuid()) @db.Uuid
  clientId           String            @map("client_id") @db.Uuid
  specialistId       String            @map("specialist_id") @db.Uuid
  serviceId          String            @map("service_id") @db.Uuid
  startTime          DateTime          @map("start_time") @db.Timestamptz()
  endTime            DateTime          @map("end_time") @db.Timestamptz()
  totalPriceRon      Decimal           @map("total_price_ron") @db.Decimal(10, 2)
  status             AppointmentStatus @default(CONFIRMED)
  cancellationReason String?           @map("cancellation_reason")
  cancellationToken  String            @unique @default(uuid()) @map("cancellation_token") @db.Uuid
  notes              String?
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz()

  client     User               @relation("ClientAppointments", fields: [clientId], references: [id])
  specialist User               @relation("SpecialistAppointments", fields: [specialistId], references: [id])
  service    Service            @relation(fields: [serviceId], references: [id])
  stages     AppointmentStage[]

  @@index([specialistId, startTime, endTime])
  @@map("appointments")
}

model AppointmentStage {
  id            String            @id @default(uuid()) @db.Uuid
  appointmentId String            @map("appointment_id") @db.Uuid
  specialistId  String            @map("specialist_id") @db.Uuid
  stageOrder    Int               @map("stage_order")
  startTime     DateTime          @map("start_time") @db.Timestamptz()
  endTime       DateTime          @map("end_time") @db.Timestamptz()
  isBusy        Boolean           @default(true) @map("is_busy")
  status        AppointmentStatus @default(CONFIRMED)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz()

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([specialistId, isBusy, status, startTime, endTime])
  @@map("appointment_stages")
}

model WaitlistEntry {
  id            String         @id @default(uuid()) @db.Uuid
  clientId      String         @map("client_id") @db.Uuid
  specialistId  String         @map("specialist_id") @db.Uuid
  serviceId     String         @map("service_id") @db.Uuid
  desiredDate   String         @map("desired_date") // "YYYY-MM-DD"
  status        WaitlistStatus @default(WAITING)
  priorityToken String?        @unique @map("priority_token") @db.Uuid
  notifiedAt    DateTime?      @map("notified_at") @db.Timestamptz()
  expiresAt     DateTime?      @map("expires_at") @db.Timestamptz()
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz()

  client  User    @relation(fields: [clientId], references: [id])
  service Service @relation(fields: [serviceId], references: [id])

  @@map("waitlist_entries")
}
